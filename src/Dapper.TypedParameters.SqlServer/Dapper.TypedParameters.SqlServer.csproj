<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Dapper.TypedParameters.SqlServer</AssemblyName>
    <RootNamespace>Dapper.TypedParameters.SqlServer</RootNamespace>
    <PackageId>TypedParameters.Dapper.SqlServer</PackageId>
    <Title>Typed Parameters for Dapper - SQL Server</Title>
    <Description>Explicit, strongly typed SQL Server parameters for Dapper using Microsoft.Data.SqlClient. Control SqlDbType, size, precision, scale, direction, and table-valued parameter metadata at the call site so parameter contracts remain visible and predictable.</Description>
    <PackageTags>dapper;sql-server;mssql;microsoft-data-sqlclient;sqlclient;ado.net;parameters;typed-parameters;sql-parameters;table-valued-parameters;tvp;micro-orm;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/Dapper.TypedParameters</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix>1.0.0</VersionPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0-rc.1</PackageValidationBaselineVersion>
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="README.md" />
    <None Remove="resources/nuget-icon.png" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="resources/nuget-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
