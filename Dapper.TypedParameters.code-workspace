{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "dotnet.defaultSolution": "Dapper.TypedParameters.sln",
    "dotnet.server.useOmnisharp": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "files.associations": {
      "*.csproj": "xml",
      "*.props": "xml",
      "*.targets": "xml"
    },
    "files.exclude": {
      "**/.git": true,
      "**/.vs": true,
      "**/.dotnet": true,
      "**/.dotnet-home": true,
      "**/.nuget": true,
      "**/bin": true,
      "**/obj": true,
      "**/TestResults": true,
      "**/artifacts": true,
      "**/coverage": true,
      "**/coverage-*": true
    },
    "search.exclude": {
      "**/.git": true,
      "**/.vs": true,
      "**/.dotnet": true,
      "**/.dotnet-home": true,
      "**/.nuget": true,
      "**/bin": true,
      "**/obj": true,
      "**/TestResults": true,
      "**/artifacts": true,
      "**/coverage": true,
      "**/coverage-*": true
    },
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/.vs/**": true,
      "**/.dotnet/**": true,
      "**/.dotnet-home/**": true,
      "**/.nuget/**": true,
      "**/bin/**": true,
      "**/obj/**": true,
      "**/TestResults/**": true,
      "**/artifacts/**": true,
      "**/coverage/**": true,
      "**/coverage-*/**": true
    },
    "search.useIgnoreFiles": true,
    "search.useGlobalIgnoreFiles": true
  }
}
